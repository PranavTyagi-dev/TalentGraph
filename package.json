{
  "name": "talentgraph",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "vite build client --outDir ../dist --emptyOutDir",
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:ui": "vite client",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "vite": "7.3.8"
  }
}
